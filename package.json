{
  "name": "teatro-ucb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "prisma generate && tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node server/start.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-admin": "tsx prisma/seed-admin.ts",
    "db:seed-superadmin": "tsx prisma/seed-superadmin.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "setup": "npm ci && docker compose up -d db && npm run db:deploy && npm run db:seed",
    "verify": "node scripts/verify-environment.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
